<div
  id="announcement-bar"
  class="fixed left-0 top-20 z-40 w-full px-2 sm:px-4"
>
  <div
    class="relative mx-auto flex w-full max-w-5xl items-stretch overflow-hidden rounded-b-2xl"
    style="
      background: linear-gradient(90deg, #4f6ef0 0%, #2952e3 100%);
      min-height: 78px;
      box-shadow: 0 8px 32px rgba(41,82,227,0.5);
    "
  >
    <div class="z-10 flex min-w-0 flex-1 flex-col justify-center px-3 py-3 sm:pl-5 md:pl-8 sm:pr-3">
      <p class="text-white font-black uppercase leading-tight"
         style="font-size: clamp(0.68rem, 1.6vw, 1.05rem); text-shadow: 0 1px 10px rgba(0,0,0,0.3); letter-spacing: 0.01em;">
        Your competitors are already advertising.
      </p>
      <p class="text-white/85 font-medium leading-snug mt-1"
         style="font-size: clamp(0.58rem, 1.1vw, 0.85rem);">
        Find out how we can help you get more customers
      </p>
    </div>

    <div class="z-10 hidden shrink-0 flex-col items-center justify-center border-l border-white/20 px-4 sm:flex">
      <span id="bar-timer"
        class="text-white font-black tabular-nums leading-none"
        style="font-size: 1.6rem; text-shadow: 0 2px 8px rgba(0,0,0,0.3);">
        10:00
      </span>
      <span class="text-white/60 font-bold uppercase tracking-widest mt-1" style="font-size: 0.55rem;">
        min
      </span>
    </div>

    <div class="z-10 flex shrink-0 items-center border-l border-white/20 px-2 sm:px-3 md:px-5">
      <button
        id="bar-cta"
        class="bg-white text-[#2952e3] font-black uppercase tracking-wide rounded-lg hover:bg-blue-50 active:scale-95 transition-all whitespace-nowrap shadow-lg cursor-pointer border-0"
        style="font-size: clamp(0.58rem, 1.2vw, 0.85rem); padding: 0.55rem 0.7rem;"
      >
        Quote Now →
      </button>
    </div>
  </div>
</div>

<script>
  const DURATION_MS = 10 * 60 * 1000;
  const TIMER_KEY = 'axis_bar_deadline';

  let deadline: number;
  const stored = sessionStorage.getItem(TIMER_KEY);
  const storedNum = stored ? parseInt(stored, 10) : 0;

  if (!storedNum || storedNum <= Date.now()) {
    deadline = Date.now() + DURATION_MS;
    sessionStorage.setItem(TIMER_KEY, String(deadline));
  } else {
    deadline = storedNum;
  }

  const timerEl = document.getElementById('bar-timer');

  function pad(n: number): string {
    return String(n).padStart(2, '0');
  }

  function tick() {
    const remaining = Math.max(0, deadline - Date.now());
    const totalSeconds = Math.floor(remaining / 1000);
    const m = Math.floor(totalSeconds / 60);
    const s = totalSeconds % 60;
    if (timerEl) timerEl.textContent = `${pad(m)}:${pad(s)}`;
    if (remaining > 0) setTimeout(tick, 1000);
  }

  tick();

  const bar = document.getElementById('announcement-bar');
  const HIDDEN_KEY = 'axis_bar_submitted';

  if (sessionStorage.getItem(HIDDEN_KEY) === '1') {
    bar?.remove();
  }

  const ctaBtn = document.getElementById('bar-cta');
  ctaBtn?.addEventListener('click', () => {
    const target = document.getElementById('contact-form');
    if (target) {
      const offset = 80 + 80 + 12;
      const top = target.getBoundingClientRect().top + window.scrollY - offset;
      window.scrollTo({ top, behavior: 'smooth' });
    } else {
      window.location.href = '/contact#contact-form';
    }
  });

  const form = document.querySelector('form[action*="formspree"]') as HTMLFormElement | null;
  form?.addEventListener('submit', () => {
    sessionStorage.setItem(HIDDEN_KEY, '1');
    bar?.classList.add('opacity-0', 'pointer-events-none');
    setTimeout(() => bar?.remove(), 400);
  });
</script>