---
const features = [
  {
    title: "We focus on results, not vanity metrics.",
    description:
      "Every decision we make is designed to generate real business outcomes.",
    id: "results",
  },
  {
    title: "We use data to drive smarter growth.",
    description:
      "Our strategies are backed by data, tested in the real world and constantly optimized.",
    id: "data",
  },
  {
    title: "We build systems, not one-off campaigns.",
    description:
      "Our systems are designed to generate consistent leads and long-term ROI.",
    id: "systems",
  },
  {
    title: "We grow when you grow.",
    description:
      "Your success is our success. We're committed to being your long-term growth partner.",
    id: "growth",
  },
];
---

<section
  class="relative w-full bg-white text-slate-950 py-24 px-6 md:px-12 overflow-hidden font-sans select-none"
>
  <div
    class="absolute top-0 left-0 w-[400px] h-[400px] bg-[radial-gradient(circle_at_top_left,_var(--tw-gradient-stops))] from-blue-400/10 via-transparent to-transparent pointer-events-none"
  >
  </div>
  <div
    class="absolute top-0 right-0 w-[400px] h-[400px] bg-[radial-gradient(circle_at_top_right,_var(--tw-gradient-stops))] from-blue-400/10 via-transparent to-transparent pointer-events-none"
  >
  </div>

  <div
    class="max-w-7xl mx-auto flex flex-col items-center relative z-10 text-center"
  >
    <span
      class="text-xs uppercase tracking-[0.25em] font-extrabold text-blue-600 mb-4"
    >
      Why talk to us?
    </span>

    <h2
      class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tighter leading-[1.05] text-[#0b132b] mb-3"
    >
      Not another agency. <br />
      A <span class="text-[#0A6AE8] font-extrabold">growth partner.</span>
    </h2>

    <p
      class="text-sm md:text-base text-slate-500 max-w-2xl leading-relaxed mb-16 opacity-90"
    >
      We're not here to sell you ads. We're here to build a system that brings
      you <br class="hidden md:inline" /> more customers, month after month.
    </p>

    <div
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 md:gap-10 w-full mb-20"
    >
      {
        features.map((item) => (
          <div class="flex flex-col items-center text-center px-4">
            <div class="w-20 h-20 rounded-full bg-blue-50 flex items-center justify-center text-blue-600 mb-6 shadow-sm shadow-blue-100/50">
              {item.id === "results" && (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="32"
                  height="32"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="lucide lucide-target"
                >
                  <circle cx="12" cy="12" r="10" />
                  <circle cx="12" cy="12" r="6" />
                  <circle cx="12" cy="12" r="2" />
                </svg>
              )}
              {item.id === "data" && (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="32"
                  height="32"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="lucide lucide-chart-no-axes-combined"
                >
                  <path d="M12 16v5" />
                  <path d="M16 14.639V21" />
                  <path d="M20 10.656V21" />
                  <path d="m22 3-8.646 8.646a.5.5 0 0 1-.708 0L9.354 8.354a.5.5 0 0 0-.707 0L2 15" />
                  <path d="M4 18.463V21" />
                  <path d="M8 14.656V21" />
                </svg>
              )}
              {item.id === "systems" && (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="32"
                  height="32"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="lucide lucide-route"
                >
                  <circle cx="6" cy="19" r="3" />
                  <path d="M9 19h8.5a3.5 3.5 0 0 0 0-7h-11a3.5 3.5 0 0 1 0-7H15" />
                  <circle cx="18" cy="5" r="3" />
                </svg>
              )}
              {item.id === "growth" && (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="32"
                  height="32"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="lucide lucide-user"
                >
                  <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" />
                  <circle cx="12" cy="7" r="4" />
                </svg>
              )}
            </div>

            <h3 class="text-[15px] font-bold text-slate-900 leading-snug tracking-tight mb-3 max-w-[200px]">
              {item.title}
            </h3>

            <p class="text-xs text-slate-400 leading-relaxed max-w-[240px]">
              {item.description}
            </p>
          </div>
        ))
      }
    </div>

    <div
      class="w-full flex flex-col items-center pt-8 border-t border-slate-100"
    >
      <h3 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tighter leading-[1.05] text-slate-900 mb-4">
  Your next customers are out there. <br />
  <span class="text-[#0A6AE8] font-extrabold">Let's build the system to reach them.</span>
</h3>

      <a
        href="../contact"
        class="inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white font-medium text-sm py-3.5 px-6 rounded-md transition-all duration-300 shadow-lg shadow-blue-600/20 hover:shadow-blue-600/30 active:scale-95"
      >
        Discover Opportunities
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="2.5"
          stroke="currentColor"
          class="w-4 h-4"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"></path>
        </svg>
      </a>
    </div>
  </div>
</section>
