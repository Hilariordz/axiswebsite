---
const logos = [
  { src: "/images/capitaldent.png", alt: "Capital Dent" },
  { src: "/images/clp.png", alt: "CLP" },
  { src: "/images/consultorio.png", alt: "Consultorio" },
  { src: "/images/guad-on-whells.png", alt: "Guad on Wheels" },
  { src: "/images/guadalajara.png", alt: "Guadalajara" },
  { src: "/images/icom.png", alt: "ICOM" },
  { src: "/images/ito´s.png", alt: "Ito's" },
  { src: "/images/lowa.png", alt: "Lowa" },
  { src: "/images/martinez.png", alt: "Martinez" },
  { src: "/images/sicomoro.png", alt: "Sicomoro" },
  { src: "/images/sipe.png", alt: "Sipe" },
];

const doubleLogos = [...logos, ...logos];
---

<section 
  class="relative w-full text-white py-20 px-6 md:py-28 md:px-12 overflow-hidden select-none my-12 bg-cover bg-center bg-no-repeat"
  style="background-image: url('/images/background.webp');"
>
  <div class="absolute inset-0 bg-zinc-950/85 z-0"></div>
  <div class="absolute inset-0 bg-[#0A6AE8]/10 z-0"></div>

  <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-[1.4fr_auto_2fr] gap-10 lg:gap-16 items-center relative z-10">
    
    <div class="flex flex-col gap-4 text-center lg:text-left z-20">
      <span class="text-xs uppercase tracking-[0.25em] text-[#0A6AE8] font-extrabold">
        Trusted by businesses
      </span>
      <h2 class="text-4xl md:text-5xl font-bold tracking-tighter leading-[1.05]">
        We help companies scale <br class="hidden lg:inline"/>
        with systems <span class="text-[#0A6AE8]">that actually work.</span>
      </h2>
    </div>

    <div class="hidden lg:block w-[1px] h-32 bg-white/15 self-center z-20"></div>

    <div class="flex flex-col gap-8 relative justify-center overflow-hidden">
      
  <div class="relative w-full overflow-hidden mask-fade">
    <div class="flex w-max gap-12 md:gap-16 items-center animate-marquee hover:[animation-play-state:paused] py-4 cursor-pointer">
      {doubleLogos.map((logo) => (
  <div class="flex items-center justify-center min-w-[120px] md:min-w-[150px] transition-all duration-300 hover:scale-105">
    <img
      src={logo.src}
      alt={logo.alt}
      class="h-28 md:h-36 w-auto object-contain opacity-95 hover:opacity-100 transition-all duration-300" 
      loading="lazy"
    />
  </div>
))}
    </div>
  </div>

      <p class="text-xs tracking-[0.2em] uppercase text-zinc-300 text-center lg:text-left font-bold opacity-90 lg:pl-2">
        Join 150+ businesses growing with Axis
      </p>
      
    </div>

  </div>
</section>

<style>
  .animate-marquee {
    animation: marquee 40s linear infinite;
  }

  @keyframes marquee {
    0% { 
      transform: translate3d(0, 0, 0); 
    }
    100% { 
      transform: translate3d(-50%, 0, 0); 
    }
  }

  .mask-fade {
    -webkit-mask-image: linear-gradient(to right, transparent 0%, black 15%, black 85%, transparent 100%);
    mask-image: linear-gradient(to right, transparent 0%, black 15%, black 85%, transparent 100%);
  }
</style>