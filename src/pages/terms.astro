function slugify(text: string) {
  return text
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)/g, '');
}
---

<Layout>
  <Navbar />
  
  <div class="legal-page">
    <div class="legal-container">
      <header class="legal-header">
        <p class="legal-eyebrow">Legal Document</p>
        <h1 class="legal-title">Terms of Service</h1>
        <p class="legal-subtitle">
          Axis Marketing Agency, LLC — Effective Date: June 30, 2026
        </p>
      </header>

      <nav class="legal-toc" aria-label="Table of contents">
        <p class="legal-toc-title">Contents</p>
        <ol class="legal-toc-list">
          {sections.map((s) => (
            <li class="legal-toc-item">
              <a href={`#${slugify(s.title)}`} class="legal-toc-link">
                {s.title}
              </a>
            </li>
          ))}
        </ol>
      </nav>

      <article>
        {sections.map((section) => (
          <section id={slugify(section.title)} class="legal-section">
            <h2 class="legal-section-title">{section.title}</h2>
            
            {section.body && section.body.map((text) => (
              <p class="legal-paragraph">{text}</p>
            ))}

            {section.subsections && section.subsections.map((sub) => (
              <div class="legal-subsection">
                <h3 class="legal-subsection-title">{sub.title}</h3>
                {sub.body.map((text) => (
                  <p class="legal-paragraph">{text}</p>
                ))}
              </div>
            ))}

            {section.contact && (
              <address class="legal-contact-block">
                {section.contact.lines.map((line) => (
                  <div>{line}</div>
                ))}
              </address>
            )}
          </section>
        ))}
      </article>
    </div>
  </div>

  <Footer />
</Layout>

<style>
  .legal-page {
    background-color: #ffffff;
    color: #000000;
    padding: 80px 20px 120px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }
  .legal-container {
    max-width: 720px;
    margin: 0 auto;
  }
  .legal-header {
    margin-bottom: 40px;
    border-bottom: 2px solid #000000;
    padding-bottom: 20px;
  }
  .legal-eyebrow {
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: bold;
    color: #666666;
    margin: 0 0 8px;
  }
  .legal-title {
    font-size: 32px;
    line-height: 1.2;
    margin: 0 0 8px;
    font-weight: 800;
    color: #000000;
  }
  .legal-subtitle {
    font-size: 13px;
    color: #555555;
    margin: 0;
  }
  .legal-toc {
    margin-bottom: 40px;
    padding: 20px;
    border: 1px solid #000000;
    background-color: #fafafa;
  }
  .legal-toc-title {
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: bold;
    margin: 0 0 12px;
  }
  .legal-toc-list {
    columns: 2;
    column-gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .legal-toc-item {
    break-inside: avoid;
    margin-bottom: 8px;
    font-size: 13px;
  }
  .legal-toc-link {
    color: #000000;
    text-decoration: underline;
  }
  .legal-toc-link:hover {
    text-decoration: none;
  }
  .legal-section {
    margin-bottom: 40px;
    scroll-margin-top: 40px;
  }
  .legal-section-title {
    font-size: 18px;
    font-weight: 700;
    color: #000000;
    border-bottom: 1px solid #000000;
    padding-bottom: 8px;
    margin-bottom: 16px;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }
  .legal-subsection {
    margin-top: 24px;
    margin-bottom: 16px;
    padding-left: 12px;
    border-left: 1px solid #e0e0e0;
  }
  .legal-subsection-title {
    font-size: 14px;
    font-weight: 700;
    color: #000000;
    margin-bottom: 8px;
  }
  .legal-paragraph {
    font-size: 14px;
    line-height: 1.6;
    color: #222222;
    margin-bottom: 14px;
    text-align: justify;
  }
  .legal-contact-block {
    font-style: normal;
    font-size: 14px;
    line-height: 1.6;
    color: #000000;
    margin-top: 12px;
    font-weight: 500;
  }
</style>