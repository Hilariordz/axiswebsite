---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Stats from '../components/Stats.astro';
import SystemSection from '../components/SystemSection.astro';
import CampaignsSection from '../components/CampaignsSection.astro';
import WhyChooseUs from '../components/WhyChooseUs.astro';
import ServiceFlow from '../components/ServiceFlow.astro';
import Cta from '../components/Cta.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
	<Navbar/>
	<section class="bg-white">
		<Hero/>
	</section>
	<SystemSection/>
	<WhyChooseUs/>
	<CampaignsSection/>
	<ServiceFlow/>
	<Cta primaryText="Get Your Custom Growth Plan" secondaryText="See How The System Works"/>
	<Footer/>
</Layout>
